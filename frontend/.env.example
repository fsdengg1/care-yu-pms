# CareYu PMS Frontend — public build variables only.
#
# Cloudflare Pages: leave NEXT_PUBLIC_API_URL empty so the browser calls
# same-origin /api/*, which is reverse-proxied to the Worker.
# Set it only if you want the browser to call the Worker URL directly.
NEXT_PUBLIC_API_URL=

# Local Next.js rewrite target (next dev only). Do not use in Cloudflare.
BACKEND_URL=http://localhost:4100

# Build-time origin used by scripts/build-cloudflare.mjs for the /api proxy.
CLOUDFLARE_API_ORIGIN=https://careyu-backend-api.aicareyuautomation.workers.dev
