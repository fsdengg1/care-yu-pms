# CareYu PMS Frontend — public build variables only.
#
# Local dev: leave VITE_API_URL empty (Vite proxies /api -> BACKEND_URL).
# Production: leave VITE_API_URL empty (unified Worker serves /api on same origin).
VITE_API_URL=

# Local Vite dev-server proxy target (Express backend).
BACKEND_URL=http://localhost:4100
