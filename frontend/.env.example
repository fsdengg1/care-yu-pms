# CareYu PMS Frontend — public build variables only.
#
# Cloudflare Pages: leave NEXT_PUBLIC_API_URL empty. The client detects
# *.careyu-frontend.pages.dev / pms.careyu.ai and calls the Worker API directly
# (CORS-enabled). Optional: set to your Pages origin to force same-origin /api/*
# when Pages Functions proxy is deployed.
NEXT_PUBLIC_API_URL=

# Local Next.js rewrite target (next dev only). Do not use in Cloudflare.
BACKEND_URL=http://localhost:4100

# Used by scripts/build-cloudflare.mjs _redirects and functions/api proxy.
CLOUDFLARE_API_ORIGIN=https://careyu-backend-api.aicareyuautomation.workers.dev
