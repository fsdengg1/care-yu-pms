# CareYu PMS Backend - Environment Variables Template
PORT=4100
NODE_ENV=production
DATABASE_URL=postgres://user:password@host:port/database?sslmode=require
DATABASE_SSL=true

JWT_SECRET=your_production_jwt_secret_key_here
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=30d

FRONTEND_URL=https://careyu-frontend.pages.dev
CORS_ORIGIN=https://careyu-frontend.pages.dev,https://pms.careyu.ai
CLOUDFLARE_WORKER=1

ALLOWED_EMAIL_DOMAINS=careyu.ai
SUPPORT_EMAIL=admin@careyu.ai

EMAIL_PROVIDER=elasticemail
EMAIL_FROM=aicareyuautomation@gmail.com
EMAIL_FROM_NAME=CareYu Automation
ELASTIC_EMAIL_API_KEY=your_elastic_email_api_key_here

APP_TIMEZONE=Asia/Kolkata
NOTIFICATION_SCHEDULER_ENABLED=true
DAILY_DIGEST_ENABLED=true
