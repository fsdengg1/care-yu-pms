{
  "name": "careyu-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc && node -e \"console.log('Backend compiled to dist/')\"",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "deploy:worker": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "dry-run:worker": "wrangler deploy --dry-run",
    "db:ensure": "tsx scripts/ensure-database.ts",
    "db:schema": "tsx scripts/apply-pms-schema.ts",
    "db:prune-users": "tsx scripts/prune-users-keep-leadership.ts",
    "db:migrate": "tsx scripts/migrate-to-postgres.ts",
    "db:migrate:force": "tsx scripts/migrate-to-postgres.ts --force-local",
    "test:permissions": "tsx scripts/verify-permissions.ts",
    "test:daily-work": "tsx scripts/verify-daily-work-matrix.ts",
    "test:login": "tsx scripts/verify-login-isolate.ts",
    "test:notifications": "tsx scripts/verify-notifications.ts",
    "test:lead-workflow": "tsx scripts/verify-lead-workflow.ts"
  },
  "dependencies": {
    "@elasticemail/elasticemail-client": "^4.0.26",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "wrangler": "^4.129.0"
  }
}
