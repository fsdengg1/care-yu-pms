{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "careyu-backend-api",
  "account_id": "ecea99dafa2e59907d7ee4d33150bfe4",
  "main": "src/worker.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "0 2 * * *",
      "30 5 * * *",
      "45 13 * * *"
    ]
  },
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "CLOUDFLARE_WORKER": "1",
    "NODE_ENV": "production",
    "APP_TIMEZONE": "Asia/Kolkata",
    "DATABASE_SSL": "true",
    "CORS_ORIGIN": "https://pms.careyu.ai,https://careyu-backend-api.aicareyuautomation.workers.dev,http://localhost:3000,http://127.0.0.1:3000",
    "FRONTEND_URL": "https://pms.careyu.ai"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6cfb190968a546e8ac667c6c616d6f4d"
    }
  ]
}
