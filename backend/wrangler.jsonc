{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "careyu-backend-api",
  "account_id": "ecea99dafa2e59907d7ee4d33150bfe4",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "0 2 * * *",
      "45 5 * * *",
      "45 13 * * *"
    ]
  },
  "vars": {
    "CLOUDFLARE_WORKER": "1",
    "NODE_ENV": "production",
    "APP_TIMEZONE": "Asia/Kolkata",
    "DATABASE_SSL": "true",
    "CORS_ORIGIN": "https://careyu-frontend.pages.dev,https://pms.careyu.ai",
    "FRONTEND_URL": "https://careyu-frontend.pages.dev"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6cfb190968a546e8ac667c6c616d6f4d"
    }
  ]
}
