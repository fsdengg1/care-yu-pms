# CareYu PMS Root Environment Variables Template
# TEMPLATE ONLY — copy values into backend/.env and frontend/.env.local as needed.
NODE_ENV=production

# Backend Database & Auth Secrets
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
DATABASE_SSL=true
JWT_SECRET=your_jwt_secret_key_here

# Frontend & Domain Configuration
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4100
CORS_ORIGIN=http://localhost:3000,https://pms.careyu.ai

# Integrations & Email
ELASTIC_EMAIL_API_KEY=your_elastic_email_api_key_here
EMAIL_FROM=aicareyuautomation@gmail.com
# Automatic pending task/lead reminder emails only. Email Reports are unaffected.
ENABLE_PENDING_EMAIL_NOTIFICATIONS=false
