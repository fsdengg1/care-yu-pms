# CareYu PMS Root Environment Variables Template
# TEMPLATE ONLY — Cloudflare Workers do not read this file or backend/.env.
# Production secrets go in: npx wrangler secret put DATABASE_URL
NODE_ENV=production

# Backend Database & Auth Secrets
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
DATABASE_SSL=true
JWT_SECRET=your_jwt_secret_key_here

# Frontend & Domain Configuration
FRONTEND_URL=https://careyu-frontend.pages.dev
API_URL=https://careyu-backend-api.aicareyuautomation.workers.dev
CORS_ORIGIN=https://careyu-frontend.pages.dev,https://pms.careyu.ai

# Integrations & Email
ELASTIC_EMAIL_API_KEY=your_elastic_email_api_key_here
EMAIL_FROM=aicareyuautomation@gmail.com

# Cloudflare Storage
R2_BUCKET_NAME=careyu-documents
